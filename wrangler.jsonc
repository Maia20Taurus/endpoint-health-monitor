/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "endpoint-health-monitor",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"upload_source_maps": true,
	"vars": {
		"MONITORED_ENDPOINT": "http://127.0.0.1:4444"
	},
	"kv_namespaces": [
		{
			"binding": "ENDPOINT_STATE",
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "ENDPOINT_ANALYTICS",
			"dataset": "ENDPOINT_ANALYTICS"
		}
	],
	"vpc_networks": [
		{
			"binding": "TUNNEL",
			"tunnel_id": "a2d23ba9-749a-4ea7-9425-c7c0dbe84b51",
			"remote": true
		}
	],
	"secrets": {
		"required": [
			"WEBHOOK"
		]
	}
}