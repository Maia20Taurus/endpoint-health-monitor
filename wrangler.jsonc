/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "endpoint-health-monitor",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"upload_source_maps": true,
	"vars": {
		"MONITORED_ENDPOINT": "https://maia395.dev"
	},
	"kv_namespaces": [
		{
			"binding": "ENDPOINT_STATE",
			"id": "66af61aca63f434094bbd3524e90a500"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "ENDPOINT_ANALYTICS",
			"dataset": "ENDPOINT_ANALYTICS"
		}
	],
	"vpc_networks": [
		{
			"binding": "ERSA",
			"tunnel_id": "f2dcbcac-c693-4dbd-a131-253dd8020fa8",
			"remote": true 
		}
	]
}